<!DOCTYPE html>
<html>

<body>
    <h2>Multiplication with JavaScript Async / Await</h2>
    <p>8 x 5 = ?</p>
    <p id="demo"></p>
    <script>
        async function multiply(a, b) {
            let response = await 8 * 5;
            display(response);
        }
        function display(some) {
            document.getElementById("demo").innerHTML = some;
        }
        multiply(8, 5);
    </script>
</body>

</html>